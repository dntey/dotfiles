;; Based on https://github.com/karthink/gptel/discussions/1067.  Fetch model
;; metadata so GPTel can display OpenRouter pricing and capabilities.
(defun dy/gptel-fetch-openrouter-models ()
  "Fetch OpenRouter models and return (ID . MODEL-PLIST) entries."
  (let ((url-request-extra-headers '(("Accept" . "application/json"))))
    (with-current-buffer
        (or (url-retrieve-synchronously
             "https://openrouter.ai/api/v1/models" t t 15)
            (error "Unable to retrieve OpenRouter models"))
      (unwind-protect
          (progn
            (goto-char (point-min))
            (unless (re-search-forward "\r?\n\r?\n" nil t)
              (error "Invalid response from OpenRouter"))
            (let* ((data (json-parse-buffer
                          :object-type 'plist
                          :array-type 'list
                          :null-object nil
                          :false-object :json-false)))
              (mapcar (lambda (model)
                        (cons (plist-get model :id) model))
                      (plist-get data :data))))
        (kill-buffer (current-buffer))))))

(defun dy/gptel-guess-capabilities (description)
  "Heuristically infer GPTel capabilities from DESCRIPTION."
  (let ((text (downcase (or description "")))
        capabilities)
    (when (string-match-p "tool" text) (push 'tool-use capabilities))
    (when (string-match-p "reason" text) (push 'reasoning capabilities))
    (when (string-match-p "image" text) (push 'media capabilities))
    (when (string-match-p "json" text) (push 'json capabilities))
    (when (string-match-p "url" text) (push 'url capabilities))
    (nreverse capabilities)))

(defun dy/gptel-convert-openrouter-model (model)
  "Convert OpenRouter MODEL metadata to GPTel's model plist format."
  (let* ((description (plist-get model :description))
         (context (or (plist-get model :context_length)
                      (plist-get (plist-get model :top_provider)
                                 :context_length)))
         (pricing (plist-get model :pricing))
         (input-cost
          (and pricing
               (* 1e6 (string-to-number
                       (or (plist-get pricing :prompt) "0")))))
         (output-cost
          (and pricing
               (* 1e6 (string-to-number
                       (or (plist-get pricing :completion) "0")))))
         (capabilities (dy/gptel-guess-capabilities description)))
    (append (list :description description)
            (when context (list :context-window (/ context 1000.0)))
            (when input-cost (list :input-cost input-cost))
            (when output-cost (list :output-cost output-cost))
            (when capabilities (list :capabilities capabilities)))))

(defun dy/gptel-augment-openrouter-models (ids)
  "Augment model IDS with metadata from OpenRouter's API."
  (condition-case error-data
      (let ((models (make-hash-table :test #'equal)))
        (dolist (model (dy/gptel-fetch-openrouter-models))
          (puthash (car model) (cdr model) models))
        (mapcar
         (lambda (id)
           (let* ((id-string (if (symbolp id) (symbol-name id) id))
                  (model (gethash id-string models)))
             (if model
                 (cons (intern id-string)
                       (dy/gptel-convert-openrouter-model model))
               (list (intern id-string)))))
         ids))
    (error
     (message "OpenRouter metadata unavailable: %s"
              (error-message-string error-data))
     ids)))

