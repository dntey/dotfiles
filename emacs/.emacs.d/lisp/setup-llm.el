        '((org-mode . " : ") (text-mode . "💬 :"))
        gptel-response-prefix-alist
        '((org-mode . " ") (text-mode . "> 🤖 ")))
  (gptel-make-openai
      "llama.cpp"
    :protocol "http"
    :host "100.69.2.45:8001"
    :stream t
    :models '(locallama))
  (setq gptel-model 'moonshotai/kimi-k3
        gptel-backend
        (gptel-make-openai
            "OpenRouter"
          :host "openrouter.ai"
          :endpoint "/api/v1/chat/completions"
          :stream t
          :key gptel-api-key
