;;; setup-tools.el --- Customize additional Emacs tools -*- lexical-binding: t -*-
;; DO NOT EDIT THIS FILE DIRECTLY.
;; This .el file was generated by the ../config.org file.

(use-package affe
  :ensure t
  :config
  ;; Manual preview key for `affe-grep'
  (consult-customize affe-grep :preview-key "M-."))

(use-package yasnippet
  :ensure t
  :config
  (setq yas-snippet-dirs
        (list (expand-file-name "snippets/" user-emacs-directory)))
  (yas-global-mode 1))

(use-package pdf-tools
  :ensure t)

(use-package nov
  :ensure t
  :config
  (add-to-list 'auto-mode-alist '("\\.epub\\'" . nov-mode)))

(use-package vterm
  :ensure t
  ;; vterm's native module is machine-specific.  Defer loading so a missing
  ;; local build cannot interrupt startup on a newly synced machine.
  :commands vterm)

(use-package vterm-toggle
  :ensure t
  :after vterm
  :custom
  (vterm-toggle-fullscreen-p nil)
  (vterm-toggle-scope 'project)
  :config
  (add-to-list
   'display-buffer-alist
   '((lambda (buffer-or-name _action)
       (let ((buffer (get-buffer buffer-or-name)))
         (and buffer
              (with-current-buffer buffer
                (or (eq major-mode 'vterm-mode)
                    (string-prefix-p vterm-buffer-name
                                     (buffer-name buffer)))))))
     (display-buffer-reuse-window display-buffer-at-bottom)
     (reusable-frames . visible)
     (window-height . 0.3))))

(provide 'setup-tools)
