  (setq vulpea-db-async-extraction 'full))

(use-package vulpea-ui
  :ensure t)

(use-package vulpea-journal
  :disabled t
  :ensure t
  :after (vulpea vulpea-ui)
  :config
  (vulpea-journal-setup))

(defgroup my-journal nil
  "Simple yearly Org journal."
  :group 'org)

(defcustom my-journal-dir "~/Org"
  "Directory to store yearly journal files."
  :type 'directory
  :group 'my-journal)

(defun my-journal-current-year-file ()
  "Return the path to the current year's journal file."
  (expand-file-name (format-time-string "journal-%Y.org") my-journal-dir))


(defun my-journal-today ()
  "Open today's entry in the current year's journal file.
Creates the file and heading with a date-based ID for Vulpea."
  (interactive)
  (let* ((file (my-journal-current-year-file))
         (year (format-time-string "%Y"))
         (date-heading (format-time-string "%b %d, %A"))
         ;; You can use "%Y-%m-%d" or add time "%Y%m%d%H%M%S" if you prefer
         (custom-id (format-time-string "%Y-%m-%d"))
         (is-new-file (not (file-exists-p file))))
    
    (unless (file-directory-p my-journal-dir)
      (make-directory my-journal-dir t))

    (find-file file)
    (widen)

    (when is-new-file
      (insert (format "#+title: Journal %s\n#+filetags: :journal:\n\n" year)))

    (goto-char (point-min))
    (let ((pos (org-find-exact-headline-in-buffer date-heading)))
      (if pos
          (goto-char pos)
        ;; Create the new heading if it doesn't exist
        (goto-char (point-max))
        (unless (bolp) (insert "\n"))
        (insert "* " date-heading "\n")
        (forward-line -1)
        ;; Set the custom ID directly
        (org-entry-put (point) "ID" custom-id)))

    (org-show-entry)
    (org-show-children)
    (org-end-of-meta-data t)))

