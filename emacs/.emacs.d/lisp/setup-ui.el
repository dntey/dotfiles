(use-package company
  :ensure t
  :disabled t
  :defer 2
  :custom
  (company-begin-commands '(self-insert-command))
  (company-idle-delay 0.1)
  (company-minimum-prefix-length 2)
  (company-show-numbers t)
  (company-tooltip-align-annotations t)
  (company-transformers '(company-sort-by-occurrence))
  :config
  ;; Add yasnippet support to each Company backend.  This follows the
  ;; approach from https://github.com/syl20bnr/spacemacs/pull/179.
  (defun dy/company-backend-with-yas (backend)
    "Add `company-yasnippet' to BACKEND unless it is already present."
    (if (and (listp backend) (member 'company-yasnippet backend))
        backend
      (append (if (consp backend) backend (list backend))
              '(:with company-yasnippet))))
  (setq company-backends
        (mapcar #'dy/company-backend-with-yas company-backends))
  (global-company-mode 1))

(use-package company-box
  :disabled t
  :ensure t
  :after company
  :hook (company-mode . company-box-mode))

  (use-package corfu
    :ensure t
    :config
    
  (setq corfu-cycle t                ; Enable cycling for `corfu-next/previous'
        corfu-auto t                 ; Enable auto completion
        corfu-auto-delay 60.0        ; Delay before auto-completion shows up
        corfu-separator ?\s          ; Orderless field separator
        corfu-quit-at-boundary nil   ; Never quit at completion boundary
        corfu-quit-no-match t        ; Quit when no match
        corfu-preview-current nil    ; Disable current candidate preview
        corfu-preselect-first nil    ; Disable candidate preselection
        corfu-on-exact-match nil     ; Configure handling of exact matches
        corfu-echo-documentation nil ; Disable documentation in the echo area
        corfu-scroll-margin 5)       ; Use scroll margin
    (global-corfu-mode)
    )

  ;; TAB cycle if there are only few candidates
  (setq completion-cycle-threshold 3)

  ;; Emacs 28: Hide commands in M-x which do not apply to the current mode.
  ;; Corfu commands are hidden, since they are not supposed to be used via M-x.
  (setq read-extended-command-predicate
        #'command-completion-default-include-p)

  ;; Enable indentation+completion using the TAB key.
  ;; completion-at-point is often bound to M-TAB.
  (setq tab-always-indent 'complete)

  ;; Completion in source blocks
  (use-package cape
    :ensure t
    :config
    (add-to-list 'completion-at-point-functions 'cape-elisp-symbol)
    )

