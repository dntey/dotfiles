(defun dy/toggle-delete-other-windows ()
  "Delete other windows, or restore the previous window configuration."
  (interactive)
  (if (and winner-mode
           (equal (selected-window) (next-window)))
      (winner-undo)
    (delete-other-windows)))

(winner-mode 1)
(global-set-key (kbd "C-x 1") #'dy/toggle-delete-other-windows)

