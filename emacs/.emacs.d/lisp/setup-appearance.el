;;; setup-appearance.el --- Emacs appearance settings -*- lexical-binding: t -*-
;; DO NOT EDIT THIS FILE DIRECTLY.
;; This .el file was generated by the ../config.org file.

;; Height is ten times the point size.
(set-face-attribute 'default nil
                    :font "Iosevka Nerd Font"
                    :height 140)
(set-face-attribute 'variable-pitch nil
                    :font "Tinos Nerd Font"
                    :height 1.2
                    :weight 'medium)
(set-face-attribute 'fixed-pitch nil
                    :font "SFMono Nerd Font"
                    :height 0.6
                    :weight 'medium)
(set-face-attribute 'font-lock-comment-face nil :slant 'italic)
(set-face-attribute 'font-lock-keyword-face nil :slant 'italic)

;; `kanagawa-dark' requires doom-themes, so load it only after Elpaca has
;; installed and activated doom-themes.  Top-level loading races Elpaca on a
;; fresh installation.
(use-package doom-themes
  :ensure t
  :init
  (add-to-list 'custom-theme-load-path
               (expand-file-name "themes/" user-emacs-directory))
  :config
  (setq doom-themes-enable-bold t
        doom-themes-enable-italic t)
  (load-theme 'kanagawa-light t)
  (doom-themes-org-config))

(use-package modus-themes
  :ensure t)

(use-package olivetti
  :ensure t
  :hook (org-mode nov-mode)
  :custom
  (olivetti-body-width 100))

(use-package mixed-pitch
  :ensure t
  :hook
  ;; If you want it in all text modes:
  (text-mode . mixed-pitch-mode))

;; Show hexadecimal colors using the color they represent.
(use-package rainbow-mode
  :ensure t
  :hook (org-mode prog-mode))

(defun org-icons ()
  "Replace common org syntax with pretty characters"
  (interactive)
  (setq prettify-symbols-alist '(("emacs-lisp" . "λ")
				 ("R" . "")
				 ("#+begin_src sh" . "")
				 ("#+begin_src shell" . "")
				 ("#+begin_src" . "❯")
				 ("#+end_src" . "﹉")
				 (":PROPERTIES:" . "")
				 (":END:" . "―")
				 ("#+name:" . "")
				 (":tangle" . "")
				 ("#+STARTUP:" . " ")
				 ("#+TITLE: " . "")
				 ("#+DATE: " . "⏲")
				 ("#+RESULTS:" . "")
				 ("#+NAME:" . "❯")
				 ("#+ROAM_TAGS:" . "")
				 ("#+FILETAGS:" . "")
				 ("#+HTML_HEAD:" . "")
				 ("#+SUBTITLE:" . "")
				 ("#+AUTHOR:" . "🖉")))
  (prettify-symbols-mode))

(add-hook 'org-mode-hook 'org-icons)

;; toggle prettyfiy symbols for point at cursor
(setq-default prettify-symbols-unprettify-at-point t)

(provide 'setup-appearance)
