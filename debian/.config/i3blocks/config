# Global Properties
separator=true
separator_block_width=15

# [i3-focusedwindow]
# color=$text-color
# command=~/.config/i3blocks/i3-focusedwindow
# interval=persist
# align=left

[time]
color=#DCD7BA
command=date '+%a %b %d  %H:%M'
interval=1
min_width=1400
align=center

[disk]
label=󰨆
color=#b7d0ae
# instance=/
command=~/.config/i3/scripts/disk
interval=10

[cpu_usage]
command=~/.config/i3/scripts/cpu_usage
interval=10
label=

[memory]
label=󰘚
# color=$text-color
command=~/.config/i3/scripts/memory
interval=2

[volume]
label=󰕾
color=$text-color
command=~/.config/i3/scripts/volume
instance=Master
interval=1

[battery]
command=~/.config/i3/scripts/battery
interval=30
