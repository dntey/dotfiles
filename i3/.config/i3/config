######################################################
# EXEC ON STARTUP
#   use exec for one-time on system start
#   use exec_always to start every time i3 reloads
######################################################
exec_always --no-startup-id libinput-gestures-setup restart
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -i ~/Pictures/Wallpapers/kamon-lock-screen.png -e -c 1a1a22
exec_always --no-startup-id feh --randomize --bg-fill --recursive ~/Pictures/Wallpapers
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id systemctl --user import-environment DISPLAY XDG_SESSION_TYPE XDG_SESSION_DESKTOP
exec --no-startup-id systemctl --user start i3-session.target
exec syncthing
exec nm-applet
exec emacs; move container to workspace 2; workspace 2;
exec_always --no-startup-id vicinae server --replace
exec_always --no-startup-id ~/.config/i3/scripts/dpms-watch-firefox.sh

######################################################
# I3 SETTINGS
######################################################
focus_wrapping no
tiling_drag modifier titlebar
focus_on_window_activation focus
hide_edge_borders smart
smart_borders on
default_orientation auto
workspace_layout tabbed
floating_minimum_size 768 x 432
floating_maximum_size 1920 x 1080

set $mod Mod4
floating_modifier $mod
bindsym $mod+Shift+comma reload
bindsym $mod+Shift+semicolon restart
bindsym Mod4+q kill
# Layout Bindings 
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+button2 --whole-window floating toggle
# change focus between tiling / floating windows
bindsym $mod+period floating toggle
bindsym $mod+Shift+period focus mode_toggle

# Layout Orientation
bindsym $mod+Shift+t layout tabbed
bindsym $mod+Shift+r layout toggle split
bindsym $mod+Shift+s layout stacked
bindsym $mod+Shift+f fullscreen toggle
# WORKSPACES
