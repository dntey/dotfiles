# ~/.config/i3/config
# DOCS: https://i3wm.org/docs/userguide.html 

# STARTUP COMMANDS
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock-fancy
exec syncthing
exec --no-startup-id picom --config ~/.config/picom/picom.conf -b
exec --no-startup-id nm-applet
exec --no-startup-id feh --randomize --bg-fill --recursive ~/Pictures/Wallpapers/Places
# add side monitor as secondary display
# exec --no-startup-id xrandr --output DisplayPort-2 --auto --left-of DisplayPort-0
exec --no-startup-id vicinae server
exec --no-startup-id gammastep -b 1.0:0.5

# i3 window bar
font pango: Ubuntu Mono Nerd Font 14
for_window [class=".*"] title_format "<tt>%title</tt> | <i>%class</i>"
for_window [class=".*"] title_window_icon yes
title_align center

# SETTINGS
focus_wrapping no
tiling_drag modifier titlebar
focus_on_window_activation focus

# Layout
hide_edge_borders smart
smart_borders on
default_orientation horizontal
focus_follows_mouse yes

# Gaps
# default_border pixel 2
# gaps inner 12px
# gaps outer 12px

# KEYBINDINGS
# All possible modifiers: cmd == Mod4, alt == Mod1, Ctrl, Shift
# All possible keys:
# - Letters.        a, b, c, ..., z
# - Numbers.        0, 1, 2, ..., 9
# - Keypad numbers. keypad0, keypad1, keypad2, ..., keypad9
# - F-keys.         f1, f2, ..., f20
# - Special keys.   minus, equal, period, comma, slash, backslash, quote, semicolon, backtick,
#                   leftSquareBracket, rightSquareBracket, space, enter, esc, backspace, tab
# - Keypad special. keypadClear, keypadDecimalMark, keypadDivide, keypadEnter, keypadEqual,
#                   keypadMinus, keypadMultiply, keypadPlus
# - Arrows.         Left, Down, Up, Right

set $mod Mod4
floating_modifier $mod
bindsym $mod+Shift+comma reload
bindsym $mod+Shift+semicolon restart
bindsym Mod4+q kill

# Layout Bindings 
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+button2 --whole-window floating toggle
# change focus between tiling / floating windows
bindsym $mod+period floating toggle
bindsym $mod+Shift+period focus mode_toggle

# Layout Orientation
bindsym $mod+Shift+t layout tabbed
bindsym $mod+Shift+r layout toggle split
bindsym $mod+Shift+s layout stacked
bindsym $mod+Shift+f fullscreen toggle

# Window Navigation
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Right focus right
bindsym $mod+Left focus left
bindsym $mod+Up focus up
bindsym $mod+Down focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# remapped copy paste
# as suggested by u/-Pelvis- here: https://www.reddit.com/r/i3wm/comments/ap7d1o/changing_copy_paste_keys_to_be_like_mac/

# Launcher menus in rofi
# bindsym $mod+Shift+f exec --no-startup-id kitty --class "fzf-menu" --directory ~ -e yazi
# for_window [class="fzf-menu"] floating enable, resize set 800 600, move position center

# Vicinae launchers
bindsym $mod+s exec vicinae toggle
bindsym $mod+Shift+v exec vicinae vicinae://launch/clipboard/history
bindsym $mod+f exec vicinae vicinae://launch/files/search
bindsym $mod+a exec vicinae vicinae://launch/calculator/history
bindsym $mod+b exec vicinae vicinae://launch/shortcuts/sct-da46ce545568
bindsym $mod+w exec --no-startup-id vicinae vicinae://launch/wm/switch-windows

# App Launchers
bindsym $mod+Shift+b exec firefox
bindsym $mod+t exec kitty
bindsym $mod+Shift+e exec emacs
# bindsym $mod+m exec kitty spotify_player
# bindsym Mod1+Shift+4 exec spectacle --region
# System Controls

bindsym $mod+F6 exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym $mod+F3 bar mode toggle  # toggle i3bar
bindsym $mod+F4 exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym $mod+F5 exec --no-startup-id pactl set-source-volume @DEFAULT_SOURCE@ -5% && $refresh_i3status
bindsym $mod+F11 exec i3lock-fancy # activate lockscreen

# Laptop keyboard system control buttons
# Sreen brightness controls
bindsym XF86MonBrightnessUp exec brightnessctl -qe set +4% # increase screen brightness
bindsym XF86MonBrightnessDown exec brightnessctl -qe set 4%- # decrease screen brihtness
bindsym XF86LaunchA bar mode toggle # toggle i3bar
bindsym XF86Search exec vicinae toggle # search in vicinae

# keyboard backlight (laptop)
bindsym XF86AudioMicMute exec brightnessctl --device=kbd_backlight set 8%- # increase screen brightness
bindsym XF86Sleep exec brightnessctl --device=kbd_backlight set +8% # increase screen brightness


# Pipewire-pulse
bindsym XF86AudioMute exec pactl set-sink-mute 0 toggle
# Media player controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
# # Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3status

# Logout Screen
set $mode_system System (l) lock, (e) logout, (s) suspend, (r) reboot, (Shift+s) shutdown
mode "$mode_system" {
  bindsym l exec --no-startup-id i3lock-fancy -gp, mode "default"     
  bindsym e exec --no-startup-id i3-msg exit, mode "default"     
  bindsym s exec --no-startup-id systemctl suspend && i3lock-fancy -gp, mode "default"     
  bindsym r exec --no-startup-id systemctl reboot, mode "default"     
  bindsym Shift+s exec --no-startup-id systemctl poweroff, mode "default"
  # back to normal: Enter or Escape     
  bindsym Return mode "default"     
  bindsym Escape mode "default"  
}  
bindsym Mod4+Shift+q mode "$mode_system"

# Resize Window
mode "resize" {
        bindsym w resize grow width    5 px or 5 ppt
        bindsym n resize shrink width  5 px or 5 ppt
        bindsym t resize grow height   5 px or 5 ppt
        bindsym s resize shrink height 5 px or 5 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

