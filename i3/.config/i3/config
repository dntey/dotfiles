######################################################
# KEYBINDINGS
######################################################

# KEYBINDINGS
# All possible modifiers: cmd == Mod4, alt == Mod1, Ctrl, Shift
# All possible keys:
# - Letters.        a, b, c, ..., z
# - Numbers.        0, 1, 2, ..., 9
# - Keypad numbers. keypad0, keypad1, keypad2, ..., keypad9
# - F-keys.         f1, f2, ..., f20
# - Special keys.   minus, equal, period, comma, slash, backslash, quote, semicolon, backtick,
#                   leftSquareBracket, rightSquareBracket, space, enter, esc, backspace, tab
# - Keypad special. keypadClear, keypadDecimalMark, keypadDivide, keypadEnter, keypadEqual,
#                   keypadMinus, keypadMultiply, keypadPlus
# - Arrows.         Left, Down, Up, Right

# Layout Bindings 
# bindsym $mod+Tab focus next
# bindsym $mod+Shift+Tab focus prev
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+button2 --whole-window floating toggle
# change focus between tiling / floating windows
bindsym $mod+period floating toggle
bindsym $mod+Shift+period focus mode_toggle

# Layout Orientation
bindsym $mod+Shift+t layout tabbed
bindsym $mod+Shift+r layout toggle split
bindsym $mod+Shift+s layout stacked
bindsym $mod+Shift+f fullscreen toggle
# Window Navigation
bindsym $mod+Right focus right
bindsym $mod+Left focus left
bindsym $mod+Up focus up
bindsym $mod+Down focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+n focus next sibling
bindsym $mod+p focus prev sibling
bindsym $mod+u focus parent
bindsym $mod+d focus child

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Press $mod+; followed by either f, t, Escape or Return to launch firefox,
# thunderbird or return to the default mode, respectively.
set $mode_layout Layout: [f]loating [s]tacking [t]abbed split[h]/[v]
bindsym $mod+semicolon mode "$mode_layout"

mode "$mode_layout" {
    bindsym f floating toggle
    bindsym s layout stacking
    bindsym t layout tabbed
    bindsym h layout splith
    bindsym v layout splitv

    bindsym Escape mode "default"
    bindsym Return mode "default"
}

focus_follows_mouse no
mouse_warping output
bindsym $mod+F1 exec --no-startup-id ~/.config/i3/scripts/picom-toggle.sh 
bindsym $mod+Return exec kitty
bindsym $mod+t [class="kitty"] focus

bindsym $mod+Shift+e exec emacsclient -c
bindsym $mod+e [class="Emacs"] focus

bindsym $mod+Shift+b exec firefox
# bindsym $mod+b [class="org.mozilla.firefox"] focus
# Vicinae launchers
bindsym $mod+s exec vicinae toggle
bindsym $mod+Shift+v exec vicinae vicinae://launch/clipboard/history
bindsym $mod+f exec vicinae vicinae://launch/files/search
bindsym $mod+a exec vicinae vicinae://launch/calculator/history
bindsym $mod+b exec vicinae vicinae://launch/@ShaderCompilation/store.vicinae.simple-bookmarks/simple-bookmarks
bindsym $mod+w exec --no-startup-id vicinae vicinae://launch/@dntey/i3-window-grid/test
bindsym $mod+z exec --no-startup-id vicinae vicinae://launch/@c4n4m1/store.vicinae.zoxide-recent-directories/recent-directories
# Simulate ctrl+c upon pressing $mod+c
bindsym --release $mod+c exec --no-startup-id xdotool key --clearmodifiers ctrl+c
bindsym --release $mod+v exec --no-startup-id xdotool key --clearmodifiers ctrl+v

# System Controls

bindsym $mod+F6 exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym $mod+F3 exec i3-msg bar mode toggle  # toggle i3bar
bindsym $mod+F4 exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym $mod+F5 exec --no-startup-id pactl set-source-volume @DEFAULT_SOURCE@ -5% && $refresh_i3status
bindsym $mod+F11 exec i3lock-fancy # activate lockscreen

# Pipewire-pulse
bindsym XF86AudioMute exec pactl set-sink-mute 0 toggle
# Media player controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
# # Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +8% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -8% && $refresh_i3status

# Laptop keyboard system control buttons
# Sreen brightness controls
bindsym XF86MonBrightnessUp exec brightnessctl -qe set +4% # increase screen brightness
bindsym XF86MonBrightnessDown exec brightnessctl -qe set 4%- # decrease screen brihtness
bindsym XF86LaunchA exec i3-msg bar mode toggle # toggle i3bar
bindsym XF86Search exec vicinae toggle # search in vicinae

# keyboard backlight (laptop)
bindsym XF86AudioMicMute exec brightnessctl --device=kbd_backlight set 8%- # increase screen brightness
bindsym XF86Sleep exec brightnessctl --device=kbd_backlight set +8% # increase screen brightness



######################################################
# BAR AND COLORS
######################################################
# class                 border  backgr. text    indicator child_border
client.focused          #545464 #2A2A37 #ffffff #76946A   #C5C9C5
client.focused_inactive #625E5A #393836 #625E5A #292d2E   #282727
client.unfocused        #393836 #222222 #625E5A #9e9b93   #393836
client.urgent           #2f343A #900000 #ffffff #900000   #900000
client.placeholder      #000000 #0C0C0C #ffffff #000000   #0c0c0c
client.background       #ffffff

for_window [class="Emacs"] title_format "<tt>%title</tt>"
for_window [class="kitty"] title_format "<tt>%title</tt>"
for_window [class="(?)firefox"] title_format "<b>%title</b>"
set $bg-color            #1a1a22
set $inactive-bg-color   #1a1a22
set $active-border-color #223249
set $text-color          #C8C093
set $inactive-text-color #54546d
set $urgent-bg-color     #FF5D62
bar {
  status_command i3blocks -c ~/.config/i3blocks/config
  # output DisplayPort-0
  position bottom
  font pango:Ubuntu Mono Nerd Font 16
  # workspace_min_width 60
  mode hide
  hidden_state hide
  modifier $mod
  colors {
    background $bg-color
    separator #54546d
    statusline #ff9e3b
    #                  border             background         text
    focused_workspace  $bg-color          $bg-color          $text-color
    inactive_workspace $inactive-bg-color $inactive-bg-color $inactive-text-color
    urgent_workspace   $urgent-bg-color   $urgent-bg-color   $text-color
  }
  strip_workspace_numbers yes
}


