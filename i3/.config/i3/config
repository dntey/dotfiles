for_window [title="Desktop @ QRect.*"] kill, floating enable, border none
# show picture-in-picture across all workspaces
for_window [title="Picture-in-Picture"] sticky enable

# GNOME Apps integration
# for_window [class="org.gnome.Nautilus"] floating enable
for_window [class="gnome-system-monitor"] floating enable
# for_window [class="gnome-text-editor"] floating enable
for_window [class="org.gnome.Characters"] floating enable

# Assing Application Windows by Workspace
# assign [class="(?)firefox"] $ws1 
# assign [class="kitty"] $ws2
# assign [class="Emacs"] $ws4
# assign [class="WhatsApp"] $ws5
assign [class="steam"] $ws6
assign [class="zotero"] $ws3
assign [class="calibre"] $ws3
assign [class="(?i)^org\.gnome\.evolution$"] $ws5
assign [class="(?i)^gnome-calendar$"] $ws5
