#!/bin/bash

# 1. FIX ENVIRONMENT (Crucial for Linuxbrew/Rust binaries in i3)
export LC_ALL=en_US.UTF-8
HIST_FILE="$HOME/.fzf_launcher_history"

# 2. DEFINE PATHS
FD_CMD="/home/linuxbrew/.linuxbrew/bin/fd"      # REPLACE THIS with result of `which fd`
FZF_CMD="/usr/bin/fzf"    # REPLACE THIS with result of `which fzf`
BAT_CMD="/home/linuxbrew/.linuxbrew/bin/bat"    # REPLACE THIS with result of `which bat`

cd "$HOME" || exit # ensure search starts in Home

# --- HELPER COMMAND TO OPEN FILES ---
# 1. Save to history
# 2. Run in background (nohup)
# 3. Suppress output
OPEN_CMD="echo {} >> \"$HIST_FILE\"; nohup xdg-open {} >/dev/null 2>&1 &"

# 3. DEBUG LOGGING
# We send error messages to this file so you can read them if fzf is empty
# ERR_LOG="/tmp/fzf_launcher_error.log"
# echo "Starting script..." > "$ERR_LOG"

# 4. RUN EXECUTABLE
# Note: output of fd goes to fzf. Errors go to the log file.
# "$FD_CMD" --type f . 2>> "$ERR_LOG" | \
#     "$FZF_CMD" --preview "$BAT_CMD --style=numbers --color=always {}" \
#                --preview-window=right:50% \
#                --bind 'enter:execute-silent(nohup xdg-open {} >/dev/null 2>&1 &)+abort'

# # If we get here and fzf failed, check log
# echo "Script finished." >> "$ERR_LOG"

# --- THE PIPELINE ---

# Logic:
# 1. 'touch': Creates history file if missing.
# 2. 'tac': Reads history backwards (last line = most recent).
# 3. '$FD_CMD': Runs the standard file search.
# 4. 'awk': The '!seen[$0]++' part removes duplicates. 
#    Since History runs first, it takes priority. If fd finds the same file later, awk skips it.

touch "$HIST_FILE"

{ tac "$HIST_FILE"; "$FD_CMD" --type f .; } | \
awk '!seen[$0]++' | \
    "$FZF_CMD" --preview "$BAT_CMD --style=numbers --color=always {}" \
               --preview-window=right:50% \
               --tiebreak=index \
               --bind "enter:execute-silent($OPEN_CMD)+abort"
